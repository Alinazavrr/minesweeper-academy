# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Supabase ---
# Public, safe to ship to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-side only. Bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- OpenAI ---
# Server-side only. Used by the AI Coach edge function.
OPENAI_API_KEY=sk-proj-...
OPENAI_COACH_MODEL=gpt-4o-mini

# --- App ---
# Used for absolute-url generation in OG share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
